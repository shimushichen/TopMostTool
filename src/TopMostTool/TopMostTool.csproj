<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TopMostTool</AssemblyName>
    <RootNamespace>TopMostTool</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>窗口置顶</AssemblyTitle>
    <Description>Windows 11 窗口置顶与截图贴图工具</Description>
    <RepositoryUrl>https://github.com/shimushichen/TopMostTool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\Application.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Source\application.png;Assets\Source\tray.png" LogicalName="TopMostTool.Assets.Source.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Application.ico" LogicalName="TopMostTool.Assets.Application.ico" />
    <EmbeddedResource Include="Assets\Tray.ico" LogicalName="TopMostTool.Assets.Tray.ico" />
    <EmbeddedResource Include="Assets\Tray-*.png" LogicalName="TopMostTool.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\MenuPinIcons\*.png" LogicalName="TopMostTool.Assets.MenuPinIcons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\ScreenshotMenuIcons\*.png" LogicalName="TopMostTool.Assets.ScreenshotMenuIcons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
